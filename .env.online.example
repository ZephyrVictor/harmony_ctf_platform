# Online (production) secrets — copy to .env.online and fill in real values.
# .env.online is gitignored; never commit real secrets.
#
#   cp .env.online.example .env.online

# PostgreSQL password — use a strong random string in production.
DB_PASSWORD=change_me_to_a_strong_password

# XOR key for sensitive field encryption — random string, do NOT change after data exists.
XOR_KEY=change_me_to_a_random_xor_key

# Initial admin password (only used on first launch to seed the admin account).
ADMIN_PASSWORD=change_me_to_a_strong_admin_password
