[global]
repo1-path=/var/lib/pgbackrest
repo1-retention-full=4
repo1-retention-diff=7
repo1-cipher-type=aes-256-cbc
# Generate a strong cipher pass and store it alongside .env.online secrets.
# The cipher pass here is the SAME as DB_PASSWORD in .env.online (by convention).
repo1-cipher-pass=REPLACE_WITH_DB_PASSWORD

# Compress backups
repo1-bundle=y
repo1-bundle-size=5MiB
repo1-bundle-limit=50MiB

# Backup timeout
stop-auto=y
delta=y

[db]
pg1-path=/var/lib/postgresql/data
pg1-port=5432
pg1-user=gzctf
